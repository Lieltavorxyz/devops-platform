# Copy to .env.local for local development. .env.local is gitignored.
#
# Every VITE_* variable is compiled into the public JS bundle, so only put
# values here that are safe for any visitor to read (URLs, public IDs).
# Real secrets never go in this app: they belong in Cloudflare Pages /
# GitHub Actions secrets and are used only by server-side code.
VITE_PORTFOLIO_URL=http://localhost:5173
VITE_PLATFORM_URL=http://localhost:5174
VITE_POCKETBASE_URL=http://localhost:8090
